DB_HOST=127.0.0.1
DB_NAME=rag_chat_app
DB_USER=root
DB_PASS=
DB_PORT=3306

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-preview
# Note: The original EMBEDDING_MODEL for OpenAI is kept. This is a new one for Gemini.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google-callback.php

# SMTP Mail Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ai-rag.local
SMTP_FROM_NAME="AI RAG Assistant"
